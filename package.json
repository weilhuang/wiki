{
  "name": "weilhuang-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.19.0 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/check-content.mjs && vitepress build docs && node scripts/check-output.mjs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run docs:build"
  },
  "devDependencies": {
    "gray-matter": "4.0.3",
    "vitepress": "1.6.4",
    "vue": "3.5.43"
  },
  "overrides": { "vite": "6.4.3" }
}
