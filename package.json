{
  "name": "weilhuang-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/check-content.mjs && node scripts/check-preservation.mjs && vitepress build docs && node scripts/check-output.mjs && node scripts/check-search.mjs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run docs:build"
  },
  "devDependencies": {
    "codehike": "1.1.0",
    "gray-matter": "4.0.3",
    "jsdom": "30.1.1",
    "markdown-it": "15.0.2",
    "mermaid": "11.17.2",
    "react": "18.3.1",
    "vitepress": "1.6.4",
    "vue": "3.5.43"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
